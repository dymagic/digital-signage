@page
@model Signage.Web.Pages.Admin.Playlists.IndexModel
@{
    ViewData["Title"] = L["Playlists.Title"];
    ViewData["Section"] = "Playlists";
}
<div class="page-head">
    <h1>@L["Playlists.Title"]</h1>
    <a class="button primary" asp-page="Create">@L["Playlists.Create"]</a>
</div>
@if (Model.Items.Count == 0)
{
    <p class="empty">@L["Playlists.Empty"]</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">@L["Playlists.Field.Name"]</th>
                <th scope="col">@L["Playlists.Column.Slides"]</th>
                <th scope="col">@L["Playlists.Column.UsedBy"]</th>
                <th scope="col"><span class="visually-hidden">@L["Common.Actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <a asp-page="Edit" asp-route-id="@item.Id">@item.Name</a>
                        @if (item.Description is not null)
                        {
                            <div class="muted">@item.Description</div>
                        }
                    </td>
                    <td>@item.SlideCount</td>
                    <td>@L["Playlists.UsedByCounts", item.ScreenCount, item.GroupCount]</td>
                    <td class="actions"><a asp-page="Edit" asp-route-id="@item.Id">@L["Common.Edit"]</a></td>
                </tr>
            }
        </tbody>
    </table>
}

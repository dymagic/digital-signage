@page "/admin/playlists/{id:guid}"
@model Signage.Web.Pages.Admin.Playlists.EditModel
@{
    ViewData["Title"] = Model.Playlist!.Name;
    ViewData["Section"] = "Playlists";
}
<div class="page-head">
    <h1>@L["Playlists.Playlist"]: @Model.Playlist.Name</h1>
    <a class="button danger" asp-page="Delete" asp-route-id="@Model.Id">@L["Common.Delete"]</a>
</div>
<div class="split">
    <section>
        <h2>@L["Playlists.Slides"]</h2>
        <partial name="_PlaylistEntries" model="Model" />
    </section>
    <aside>
        <form method="post" class="form">
            <partial name="_ValidationSummary" />
            <input type="hidden" id="playlist-version" name="Version" value="@Model.Version" />
            <partial name="_PlaylistDetails" for="Input" />
            <div class="form-actions">
                <button type="submit" class="primary">@L["Common.Save"]</button>
                <a asp-page="Index">@L["Playlists.BackToList"]</a>
            </div>
        </form>
        <section class="panel">
            <h2>@L["Playlists.UsedBy"]</h2>
            @if (!Model.Usage!.InUse)
            {
                <p class="muted">@L["Playlists.UsedBy.Nothing"]</p>
            }
            else
            {
                @if (Model.Usage.Screens.Count > 0)
                {
                    <p>@L["Playlists.UsedBy.Screens"] @string.Join(", ", Model.Usage.Screens)</p>
                }
                @if (Model.Usage.Groups.Count > 0)
                {
                    <p>@L["Playlists.UsedBy.Groups"] @string.Join(", ", Model.Usage.Groups)</p>
                }
            }
        </section>
    </aside>
</div>
<script src="~/admin/reorder.js" asp-append-version="true" defer></script>

@page
@model Signage.Web.Pages.Admin.Users.CreateModel
@{
    ViewData["Title"] = L["Users.Create"];
    ViewData["Section"] = "Users";
}
<h1>@L["Users.Create"]</h1>
@if (Model.TemporaryPassword is not null)
{
    <partial name="_TemporaryPassword" model="Model.TemporaryPassword" />
    <p><a asp-page="Index">@L["Users.BackToList"]</a></p>
}
else
{
    <form method="post" class="form">
        <partial name="_ValidationSummary" />
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" type="email" autocomplete="off" />
        <span asp-validation-for="Input.Email" class="field-error"></span>
        <label asp-for="Input.DisplayName"></label>
        <input asp-for="Input.DisplayName" autocomplete="off" />
        <span asp-validation-for="Input.DisplayName" class="field-error"></span>
        <label asp-for="Input.Role"></label>
        <select asp-for="Input.Role">
            <option value="@UserRole.Editor">@L["Users.Role.Editor"]</option>
            <option value="@UserRole.Admin">@L["Users.Role.Admin"]</option>
        </select>
        <span class="hint">@L["Users.RoleHint"]</span>
        <div class="form-actions">
            <button type="submit" class="primary">@L["Users.Create"]</button>
            <a asp-page="Index">@L["Common.Cancel"]</a>
        </div>
    </form>
}

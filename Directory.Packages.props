<Project>
  <!-- Central package management: every package version lives here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Npgsql.DependencyInjection" Version="10.0.3" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <!-- The E2E runner image tag is derived from this version by scripts/test-e2e.sh. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>
</Project>
